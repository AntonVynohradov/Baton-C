{
  // Baton-C tasks: build, tests, analysis and documentation.
  // Task menu: Ctrl+Shift+B (no default build task, so VS Code shows the list).
  // Python tasks use the project virtual environment in .venv.
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "Build: Debug",
      "group": "build",
      "detail": "Static library, Debug preset",
      "type": "shell",
      "command": "cmake --preset 'BATON[Debug]' && cmake --build 'build/BATON[Debug]'",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build: Release",
      "group": "build",
      "detail": "Static library, Release preset",
      "type": "shell",
      "command": "cmake --preset 'BATON[Release]' && cmake --build 'build/BATON[Release]'",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Test: Unit tests + coverage",
      "group": "build",
      "detail": "GoogleTest and the bus simulation; fails below 100 % line or branch coverage",
      "type": "shell",
      "command": "cmake --preset 'BATON[UnitTests]' && cmake --build 'build/BATON[UnitTests]' --target coverage",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Test: Simulation, 100 seeds",
      "group": "build",
      "detail": "Bus simulation runner on 100 seeds",
      "type": "shell",
      "command": "cmake --preset 'BATON[UnitTests]' && cmake --build 'build/BATON[UnitTests]' --target baton_sim && sh tests/run_seeds.sh 'build/BATON[UnitTests]' 100",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Test: Integration (pytest)",
      "group": "build",
      "detail": "Python twin and the C/Python cross-check",
      "type": "shell",
      "command": "cmake --preset 'BATON[IntegrationTests]' && cmake --build 'build/BATON[IntegrationTests]' --target integration_tests",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Test: Examples",
      "group": "build",
      "detail": "Build the examples and run the bare-metal simulation",
      "type": "shell",
      "command": "cmake --preset 'BATON[Examples]' && cmake --build 'build/BATON[Examples]' && ctest --test-dir 'build/BATON[Examples]' -L example --output-on-failure",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Analysis: MISRA C:2012",
      "group": "build",
      "detail": "Cppcheck MISRA addon; fails on any violation",
      "type": "shell",
      "command": "cmake --preset 'BATON[Debug]' && cmake --build 'build/BATON[Debug]' --target misra-analyze",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Analysis: Cppcheck",
      "group": "build",
      "detail": "Cppcheck, all checks",
      "type": "shell",
      "command": "cmake --preset 'BATON[Debug]' && cmake --build 'build/BATON[Debug]' --target cppcheck-analyze",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Docs: Check C snippets",
      "group": "build",
      "detail": "Compile every C snippet of docs/",
      "type": "shell",
      "command": "python tools/docs/check_snippets.py",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Python: Setup venv",
      "group": "build",
      "detail": "Create .venv and install requirements-dev.txt",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/python -m pip install --upgrade -r requirements-dev.txt",
      "windows": {
        "command": "py -3 -m venv .venv; .venv\\Scripts\\python.exe -m pip install --upgrade -r requirements-dev.txt"
      },
      "problemMatcher": []
    },
    {
      "label": "Docs: Serve on localhost",
      "group": "build",
      "detail": "mkdocs serve with live reload; opens the browser",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "mkdocs", "serve", "--dev-addr", "127.0.0.1:8000", "--open"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "mkdocs",
        "pattern": { "regexp": "^(ERROR|WARNING)\\s+-\\s+(.*)$", "severity": 1, "message": 2 },
        "background": { "activesBegin": true, "beginsPattern": "Building documentation", "endsPattern": "Serving on" }
      }
    },
    {
      "label": "Docs: Build site",
      "group": "build",
      "detail": "mkdocs build into site/",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "mkdocs", "build", "--clean"],
      "problemMatcher": []
    },
    {
      "label": "Docs: Build PDF manual",
      "group": "build",
      "detail": "Print-ready A4 user manual into build/manual/; needs WeasyPrint and Pango",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["tools/docs/build_manual.py"],
      "problemMatcher": []
    },
    {
      "label": "Docs: Generate diagrams",
      "group": "build",
      "detail": "Regenerate the SVG diagrams in docs/assets/images from tools/docs/diagrams.py",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["tools/docs/diagrams.py"],
      "problemMatcher": []
    }
  ]
}
