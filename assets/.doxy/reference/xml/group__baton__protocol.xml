      <memberdef kind="function" id="group__baton__protocol_1gaecb5b1070c3f177d31da3419c1e784eb" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int baton_parser_feed</definition>
        <argsstring>(struct baton_parser *parser, uint8_t byte)</argsstring>
        <name>baton_parser_feed</name>
        <param>
          <type>struct <ref refid="structbaton__parser" kindref="compound">baton_parser</ref> *</type>
          <declname>parser</declname>
        </param>
        <param>
          <type>uint8_t</type>
          <declname>byte</declname>
        </param>
        <briefdescription>
<para>Feed one byte to the incremental frame parser. </para>
        </briefdescription>
        <detaileddescription>
<para>The parser waits for SYNC, reads the header, rejects a LEN above BATON_MAX_PAYLOAD as soon as it is read, then reads the payload and the CRC and validates it. After a valid or invalid frame it waits for the next SYNC. Bytes of a rejected frame are not re-scanned for SYNC; the inter-byte timeout of the link resynchronizes a broken stream.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>parser</parametername>
</parameternamelist>
<parameterdescription>
<para>Parser state. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>byte</parametername>
</parameternamelist>
<parameterdescription>
<para>Next byte from the input stream. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<parameterlist kind="retval"><parameteritem>
<parameternamelist>
<parametername>1</parametername>
</parameternamelist>
<parameterdescription>
<para>A complete valid frame is available in <computeroutput>parser-&gt;frame</computeroutput> until the next call. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>0</parametername>
</parameternamelist>
<parameterdescription>
<para>More bytes are required. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>BATON_PARSE_ERROR</parametername>
</parameternamelist>
<parameterdescription>
<para>NULL parser, LEN out of range, CRC mismatch or corrupted state. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
