    <sectiondef kind="user-defined">
      <header>Frame encoding</header>
      <memberdef kind="function" id="group__baton__protocol_1ga2bd21ca87b358bbc18150046075c9b7e" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int baton_encode</definition>
        <argsstring>(uint8_t dst, uint8_t src, uint8_t ctrl, const uint8_t *payload, size_t payload_length, uint8_t *output, size_t output_capacity, size_t *output_length)</argsstring>
        <name>baton_encode</name>
        <param>
          <type>uint8_t</type>
          <declname>dst</declname>
        </param>
        <param>
          <type>uint8_t</type>
          <declname>src</declname>
        </param>
        <param>
          <type>uint8_t</type>
          <declname>ctrl</declname>
        </param>
        <param>
          <type>const uint8_t *</type>
          <declname>payload</declname>
        </param>
        <param>
          <type>size_t</type>
          <declname>payload_length</declname>
        </param>
        <param>
          <type>uint8_t *</type>
          <declname>output</declname>
        </param>
        <param>
          <type>size_t</type>
          <declname>output_capacity</declname>
        </param>
        <param>
          <type>size_t *</type>
          <declname>output_length</declname>
        </param>
        <briefdescription>
<para>Encode one frame: SYNC, header, payload and CRC. </para>
        </briefdescription>
        <detaileddescription>
<para><computeroutput>payload</computeroutput> may point to <computeroutput>&amp;output[BATON_HEADER_SIZE]</computeroutput>: a payload that was built in place is then not copied.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>dst</parametername>
</parameternamelist>
<parameterdescription>
<para>Destination address. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>src</parametername>
</parameternamelist>
<parameterdescription>
<para>Source address. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>ctrl</parametername>
</parameternamelist>
<parameterdescription>
<para>Control byte, see <ref refid="group__baton__defs_1ga67b52d864b7a367b9ffa30f375cbd8e8" kindref="member">baton_ctrl()</ref>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>payload</parametername>
</parameternamelist>
<parameterdescription>
<para>Payload bytes, or NULL when <computeroutput>payload_length</computeroutput> is zero. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>payload_length</parametername>
</parameternamelist>
<parameterdescription>
<para>Number of payload bytes (at most BATON_MAX_PAYLOAD). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>output</parametername>
</parameternamelist>
<parameterdescription>
<para>Destination buffer for the complete frame. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>output_capacity</parametername>
</parameternamelist>
<parameterdescription>
<para>Capacity of <computeroutput>output</computeroutput> in bytes. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>output_length</parametername>
</parameternamelist>
<parameterdescription>
<para>Receives the frame length on success. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<parameterlist kind="retval"><parameteritem>
<parameternamelist>
<parametername>0</parametername>
</parameternamelist>
<parameterdescription>
<para>Frame encoded. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>BATON_PARSE_ERROR</parametername>
</parameternamelist>
<parameterdescription>
<para>Invalid input or insufficient output capacity. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
